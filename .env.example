# OpenRouter (default provider) — recommended
# Create a key at https://openrouter.ai/keys, then add it here or in the app's
# Dashboard (LLM settings panel). Pay-per-token, no subscription.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional overrides (leave unset to use defaults):
# LLM_MODEL=qwen/qwen3-vl-8b-instruct
# LLM_BASE_URL=https://openrouter.ai/api/v1
